      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "4bfaf524-73df-4ce3-9afb-90e1d0f5b211",
      "name": "Responder com o resultado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Telegram (Markdown simples) quebra com _ [ ` soltos no texto. O * a gente usa pra negrito.\nconst md = (t) => String(t ?? '').replace(/([_\\[`])/g, '\\\\$1');\n\nconst r = $input.first().json;\n// ok e atenção não geram alerta: a guia pode seguir. O resto a recepção resolve antes de enviar.\nif (!['bloqueada', 'pendente', 'corrigir'].includes(r.status)) return [];\nconst cfg = $('Config').first().json;\nconst chats = { Centro: cfg.chat_centro, Norte: cfg.chat_norte, Sul: cfg.chat_sul };\nconst chat = chats[r.unidade] || cfg.chat_carla;\nif (!chat) return [];   // chat ainda não configurado: não quebra, só não avisa\nconst texto = md(r.mensagem) + `\\n\\nPainel: ${cfg.app_url}/guias/${r.id_guia}`;\nreturn [{ json: { chat, texto, id_guia: r.id_guia, status: r.status } }];\n"
      },
      "id": "215f9310-1438-428e-9b76-7d7b1f60df71",
      "name": "Precisa avisar?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -100
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "appendAttribution": false
        }
      },
      "id": "3622d389-2b29-47bf-8496-3df31c90a998",
      "name": "Avisar recepção da unidade",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "name": "Telegram"
        }
      },
      "webhookId": "c9badd56-8ad5-4079-8818-0be53d74e340"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ erro: 'não consegui conferir a guia agora', detalhe: $json.error?.message ?? $json.error ?? 'sem detalhe', id_guia: $('Guia lançada').first().json.body?.id_guia ?? null }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "b1ee6d75-8c5c-4ca8-9c8e-aa7975eb2514",
      "name": "Responder erro",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Telegram (Markdown simples) quebra com _ [ ` soltos no texto. O * a gente usa pra negrito.\nconst md = (t) => String(t ?? '').replace(/([_\\[`])/g, '\\\\$1');\n\nconst cfg = $('Config').first().json;\nif (!cfg.chat_carla) return [];\nconst corpo = $('Guia lançada').first().json.body || {};\nconst erro = $input.first().json.error ?? 'app não respondeu';\nconst texto = `*Conferência fora do ar*\\nA guia ${md(corpo.id_guia || '(sem id)')} não foi conferida.\\n` +\n              `Erro: ${md(typeof erro === 'string' ? erro : JSON.stringify(erro))}\\n` +\n              `Não enviar ao convênio até conferir.`;\nreturn [{ json: { chat: cfg.chat_carla, texto } }];\n"
      },
      "id": "9b8b6ff0-a748-44d0-8e77-f02c8d75bddc",
      "name": "Montar alerta de falha",
