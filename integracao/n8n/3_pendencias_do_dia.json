    {
      "parameters": {
        "jsCode": "// WhatsApp usa *negrito* igual ao texto que vem do app: não precisa escapar nada.\nconst rel = $input.first().json;\nconst cfg = $('Config').first().json;\nif (!rel.com_problema) return [];   // nada pra resolver: não manda mensagem\nconst texto = `${rel.mensagem_pendencias}\\n\\nPainel: ${cfg.app_url}/`;\nreturn [{ json: { chat: cfg.chat_carla, texto, com_problema: rel.com_problema } }];\n"
      },
