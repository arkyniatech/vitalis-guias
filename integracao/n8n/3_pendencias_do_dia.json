    {
      "parameters": {
        "jsCode": "// Telegram (Markdown simples) quebra com _ [ ` soltos no texto. O * a gente usa pra negrito.\nconst md = (t) => String(t ?? '').replace(/([_\\[`])/g, '\\\\$1');\n\nconst rel = $input.first().json;\nconst cfg = $('Config').first().json;\nif (!rel.com_problema) return [];   // nada pra resolver: não manda mensagem\nconst texto = md(rel.mensagem_pendencias) + `\\n\\nPainel: ${cfg.app_url}/`;\nreturn [{ json: { chat: cfg.chat_carla, texto, com_problema: rel.com_problema } }];\n"
      },
