# Copie para .env e preencha. O .env está no .gitignore e NUNCA vai pro repositório.

# Banco. Supabase: Settings > Database > Connection string (URI), modo "Session" ou "Transaction".
# Troque "postgresql://" por "postgresql+psycopg://". Se deixar vazio, usa SQLite local (dados/vitalis.db).
DATABASE_URL=postgresql+psycopg://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave que o n8n / sistema de gestão manda no header X-API-Key pra registrar guias.
API_KEY=troque-por-uma-chave-longa

# Login do dashboard (HTTP Basic). Se deixar vazio, o dashboard fica aberto (só pra dev).
DASH_USER=carla
DASH_PASS=troque-tambem

# IA pra ler a observação da recepção. Se vazio, usa só o fallback por palavra-chave e nada quebra.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Caminho das regras dos convênios (JSON). Trocar o arquivo = trocar as regras, sem mexer em código.
REGRAS_PATH=dados/regras_convenio.json
